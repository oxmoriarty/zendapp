# ---- Database (required) ----------------------------------------------------
# Any standard Postgres connection string works — Neon, Supabase, RDS, Railway,
# or a local instance. No native binaries to install: the schema (lib/server/schema.ts)
# is applied with Drizzle Kit directly over the `pg` driver.
#   Local dev:  npm run db:push
#   Production: npm run db:generate   (writes a versioned SQL file to ./drizzle)
#               npm run db:migrate    (applies it)
DATABASE_URL="postgresql://user:password@localhost:5432/zendapp"

# ---- Sessions (required) -----------------------------------------------------
# Signing secret for the httpOnly session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# ---- Arc Testnet (already correct — Arc Builders Docs "Connect to Arc") -----
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_WS_URL=wss://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# ---- Email (optional in dev, required in production) ------------------------
# Without these set, verification codes and payment-received emails are
# logged to the server console instead of sent (see lib/server/email.ts).
# Sign up at https://resend.com, verify a sending domain, then set:
RESEND_API_KEY=
EMAIL_FROM="Zendapp <notifications@yourdomain.com>"

# ---- Push notifications (optional) ------------------------------------------
# Generate your own keypair per deployment:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose to the client; the private
# key must stay server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@yourdomain.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---- Profile photo storage (optional in dev, required in production) --------
# Without this set, uploaded profile photos are stored as inline data: URIs
# directly on the user record instead of an object store (see
# lib/server/avatar-storage.ts) — functional, but not how you'd want it in
# production. On Vercel: Project -> Storage -> Create Database -> Blob. That's
# it — BLOB_READ_WRITE_TOKEN is injected automatically into your deployment,
# nothing to copy-paste.
BLOB_READ_WRITE_TOKEN=
